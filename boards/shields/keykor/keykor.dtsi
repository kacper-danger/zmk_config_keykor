#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <physical_layouts.dtsi>

// <&key_physical_attrs width height x y rotation rot_x rot_y>
// All values are in 1/100 key units (100 = 1u); rotation in 1/100 degrees.
#define PHYS_KEY(x, y) <&key_physical_attrs 100 100 x y 0 0 0>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;

 //         | SW1  | SW2   | SW3   | SW4   | SW5  | SW6  |    | SW27  | SW28  | SW29 | SW30  | SW31  | SW32 |
 //         | SW7  | SW8   | SW9   | SW10  | SW11 | SW12 |    | SW33  | SW34  | SW35 | SW36  | SW37  | SW38 |
 //         | SW13 | SW14  | SW15  | SW16  | SW17 | SW18 |    | SW39  | SW40  | SW41 | SW42  | SW43  | SW44 |
 //         | SW19 | SW20  | SW21  | SW21  | SW22 | SW23 |    | SW45  | SW46  | SW47 | SW48  | SW49  | SW50 |
 //                                  | SW24  | SW25 | SW26 |    | SW51  | SW52  | SW53 |
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)             RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)             RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)             RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)             RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
                                    RC(4,3) RC(4,4) RC(4,5)             RC(4,6) RC(4,7) RC(4,8)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;

        // Same order as the map above (54 keys).
        keys =
            PHYS_KEY(0,0),    PHYS_KEY(100,0),    PHYS_KEY(200,0),    PHYS_KEY(300,0),    PHYS_KEY(400,0),    PHYS_KEY(500,0),
            PHYS_KEY(700,0),  PHYS_KEY(800,0),    PHYS_KEY(900,0),    PHYS_KEY(1000,0),   PHYS_KEY(1100,0),   PHYS_KEY(1200,0),

            PHYS_KEY(0,100),  PHYS_KEY(100,100),  PHYS_KEY(200,100),  PHYS_KEY(300,100),  PHYS_KEY(400,100),  PHYS_KEY(500,100),
            PHYS_KEY(700,100),PHYS_KEY(800,100),  PHYS_KEY(900,100),  PHYS_KEY(1000,100), PHYS_KEY(1100,100), PHYS_KEY(1200,100),

            PHYS_KEY(0,200),  PHYS_KEY(100,200),  PHYS_KEY(200,200),  PHYS_KEY(300,200),  PHYS_KEY(400,200),  PHYS_KEY(500,200),
            PHYS_KEY(700,200),PHYS_KEY(800,200),  PHYS_KEY(900,200),  PHYS_KEY(1000,200), PHYS_KEY(1100,200), PHYS_KEY(1200,200),

            PHYS_KEY(0,300),  PHYS_KEY(100,300),  PHYS_KEY(200,300),  PHYS_KEY(300,300),  PHYS_KEY(400,300),  PHYS_KEY(500,300),
            PHYS_KEY(700,300),PHYS_KEY(800,300),  PHYS_KEY(900,300),  PHYS_KEY(1000,300), PHYS_KEY(1100,300), PHYS_KEY(1200,300),

            // thumbs: left RC(4,3-5), right RC(4,6-8)
            PHYS_KEY(300,400),PHYS_KEY(400,400),  PHYS_KEY(500,400),
            PHYS_KEY(700,400),PHYS_KEY(800,400),  PHYS_KEY(900,400);
    };
};

// Trackpad events travel from the right half (peripheral) to the left half (central)
/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackpad_split: trackpad@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    // Disabled here so the keymap can reference it on both builds; enabled on the central in keykor_left.overlay
    trackpad_listener: trackpad_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackpad_split>;
    };
};
