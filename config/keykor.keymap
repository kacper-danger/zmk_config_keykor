#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

#define BASE 0
#define LOWER 1
#define UPPER 2
#define MOUSE 3

// Cirque runtime speed / mode bindings (from the module README)
#define SPEED_POINTER 0
#define SPEED_SCROLL 1
#define SPEED_PREV 0
#define SPEED_NEXT 1
#define SPEED_RESET 2
#define SPEED_FINE_PREV 3
#define SPEED_FINE_NEXT 4
#define CIRQUE_MODE_RELATIVE 0
#define CIRQUE_MODE_ABSOLUTE 1
#define CIRQUE_MODE_TOGGLE 2



/  {

behaviours {
    
    hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
};

keymap {
    compatible = "zmk,keymap";

default_layer {
display-name = "BASE"; 
// ------------------------------------------------------         ---------------------------------------------
// |  ESC-Q   |    W     |     E     |     R      |  T  |         |  Y  |      U      |     I     |  O  |  P  |
// ------------------------------------------------------         ---------------------------------------------
// |  LGUI-A  |  LALT-S  |  LCTRL-D  |  LSHIFT-F  |  G  |         |  H  |  LSHIFT-J   |  LCTRL-K  |  L  |  ;  |
// ------------------------------------------------------          --------------------------------------------
// |     Z    |     X    |     C     |     V      |  B  |         |  N  |      M      |     ,     |  .  |  /  |
// ------------------------------------------------------         ---------------------------------------------
//                                    | GUI | LWR | SPC |         | ENT | RSE  | ALT |
//                                    -------------------         --------------------

    bindings = <

    &kp N1 &kp N1     &kp N2        &kp N3         &kp N4        &kp N5               &kp N6     &kp N7        &kp N8         &kp N9   &kp N0   &kp BSPC
    &kp G &kp Q   &kp W         &kp E          &kp R         &kp T                &kp Y      &kp U         &kp I          &kp O    &kp P    &kp P
    &kp A &kp  A  &kp  S    &kp  D    &kp  F  &kp G                &kp H      &kp J  &kp  K    &kp L    &kp SEMI &kp L 
    &kp Z &kp Z       &kp X         &kp C          &kp V         &kp B                &kp N      &kp M         &kp COMMA      &kp DOT  &kp FSLH &kp M
                              &kp LGUI      &mo 1         &kp BSPC             &kp SPACE  &mo 2         &kp RALT
    >;
};


lower_layer {
 display-name = "LOWER"; 
// ---------------------------------------   --------------------------------
// |  1 !  |    2 @    | 3 # | 4 $ | 5 % |   | 6 ^ |  7 & | 8 * | 9   |  0  |
// ---------------------------------------   --------------------------------
// |  TAB  |  LGUI(E)  |     | PRNT| CAP |   |  -  |  =   | lbkt| rbkt| ' " |
// ---------------------------------------   --------------------------------
// | delete|           |     | PST | CAD |   |  _  |  +   | lbrc| rbrc|  |  |
// ---------------------------------------   --------------------------------
//                     | GUI | LWR | SPC |   | ENT | RSE  | ALT |
//                     -------------------   --------------------

    bindings = <

    &none &none &none &none &none &none                                                             &none &none &none &none &none &none 
    &none &bt BT_CLR      &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2        &none                                 &none           &none             &none             &none           &none  &none
    &none &kp TAB          &none       &none     &none    &kp CAPS                              &kp MINUS        &kp EQUAL         &kp LBKT         &kp RBKT        &none  &none
    &none &kp DEL          &none       &none     &none         &none                                 &kp UNDER        &kp PLUS          &kp LBRC         &kp RBRC        &none &none
                                 &kp LGUI  &mo 1         &kp RET                               &kp RET          &mo 2             &kp RALT
    >;
    };

raise_layer {
display-name = "UPPER"; 
// ---------------------------------   ----------------------------------------------
// | soft  |     |     | ext | ext |   |        |         |  UP    |         |delete|
// ---------------------------------   ----------------------------------------------
// |  CLR  | bt1 | bt2 | bt3 |     |   |  HOME  |  LEFT   |  DOWN  |  RIGHT  |      |
// ---------------------------------   ----------------------------------------------
// | stdulk|     |     |     |     |   |        |         |        |   END   |      |
// ---------------------------------   ----------------------------------------------
//               | GUI | LWR | SPC |   | ENT | RSE  | ALT | 
//               -------------------   --------------------

    bindings = <
    &none &none &none &none &none &none                                                                        &none &none &none &none &none &none 
    &none &soft_off       &none            &none            &ext_power EP_ON  &ext_power EP_OFF                &none      &none     &kp UP        &none        &none  &none 
    &none &bt BT_CLR      &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2      &none                            &kp HOME   &kp LEFT  &kp DOWN      &kp RIGHT    &none  &none 
    &none &studio_unlock  &none            &none            &none             &none                            &none      &none     &none         &kp END      &none  &none 
                                     &kp LGUI         &mo 1             &kp RET                          &kp RET    &mo 2     &kp RALT
    >;
    };


mouse_layer {
    display-name = "MOUSE";
    // Auto-activated by trackpad movement (see &trackpad_listener below).
    // Left half: S = middle click, D = right click, F = left click, G (hold) = scroll with pad movement
    // Bottom row: Z = toggle relative/absolute, X/C = pointer speed down/up, V/B = scroll speed down/up
    bindings = <
    &trans &trans &trans        &trans        &trans        &trans              &trans &trans &trans &trans &trans &trans
    &trans &trans &trans        &trans        &trans        &trans              &trans &trans &trans &trans &trans &trans
    &trans &trans &mkp MCLK     &mkp RCLK     &mkp LCLK     &drgscrl            &trans &trans &trans &trans &trans &trans
    &trans &crq_mode CIRQUE_MODE_TOGGLE &ptr_spd SPEED_POINTER SPEED_PREV &ptr_spd SPEED_POINTER SPEED_NEXT &ptr_spd SPEED_SCROLL SPEED_PREV &ptr_spd SPEED_SCROLL SPEED_NEXT   &trans &trans &trans &trans &trans &trans
                                &trans        &trans        &trans              &trans &trans &trans
    >;
};

extra4 {
            status = "reserved";
        };

extra5 {
            status = "reserved";
        };    
        
extra6 {
            status = "reserved";
        };






};
};

&trackpad_listener {
    // MINIMAL TEST: no transform, no speed or drag-scroll processors
    input-processors = <&zip_temp_layer MOUSE 2000>;
};

/ {
    // Pointer speed / scroll speed processors (module). 1x base speed; tune one-x-* or use the &ptr_spd keys.
    pointer_processor: pointer_processor {
        compatible = "zmk,input-processor-pointer-speed";
        #input-processor-cells = <2>;
        track-remainders;
        one-x-multiplier = <1>;
        one-x-divisor = <1>;
        min-percent = <10>;
        max-percent = <400>;
        initial-speed-position = <50>;
    };

    drag_scroll_processor: drag_scroll_processor {
        compatible = "zmk,input-processor-drag-scroll";
        #input-processor-cells = <2>;
        track-remainders;
        one-x-multiplier = <1>;
        one-x-divisor = <1>;
        min-percent = <10>;
        max-percent = <1000>;
        initial-speed-position = <50>;
        // invert-scroll;   // uncomment if scroll direction is reversed
    };

    behaviors {
        drgscrl: drag_scroll {
            compatible = "zmk,behavior-drag-scroll";
            #binding-cells = <0>;
        };

        ptr_spd: pointing_speed {
            compatible = "zmk,behavior-pointing-speed";
            #binding-cells = <2>;
        };

        crq_mode: cirque_mode {
            compatible = "zmk,behavior-cirque-mode";
            #binding-cells = <1>;
        };
    };
};
